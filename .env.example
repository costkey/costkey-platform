# Self-hosted CostKey. Copy to .env, fill in the secrets, then: docker compose up -d

# Where people and SDKs reach this server. DSNs and email links use it.
# Use https://... behind a TLS proxy; sign-in cookies follow the scheme.
PUBLIC_URL=http://localhost:4100
COSTKEY_PORT=4100

# Generate each with: openssl rand -hex 32
COSTKEY_JWT_SECRET=
COSTKEY_NOTIFICATION_ENCRYPTION_KEY=

POSTGRES_PASSWORD=costkey

# Optional: email for invites, alerts and daily or weekly summaries (Resend)
# RESEND_API_KEY=
# COSTKEY_NOTIFICATION_FROM=CostKey <alerts@your-domain.com>

# Optional: sign in with GitHub
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: coding agents (Claude Code, Cursor, Codex, VS Code) read calls,
# runs and costs at PUBLIC_URL/mcp with a token from Settings, Coding agents.
# Set to false to turn the endpoint off.
# COSTKEY_MCP_ENABLED=true
