# Self-hosted CostKey: the API server and the console in one image.
# Use docker-compose.yml to run it beside Postgres.

# Build the console and the server.
FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
COPY packages/dashboard/package.json packages/dashboard/
COPY packages/sdk/package.json packages/sdk/
COPY packages/cli/package.json packages/cli/
RUN npm ci --workspace=packages/shared --workspace=packages/server --workspace=packages/dashboard
COPY scripts/install-linux-native.mjs scripts/
RUN node scripts/install-linux-native.mjs
COPY packages/shared packages/shared
COPY packages/server packages/server
COPY packages/dashboard packages/dashboard
# The console build bundles the design prototype's fixture data.
COPY design/console-prototype/data.js design/console-prototype/data.js
RUN cd packages/shared && npx tsc \
  && cd ../server && npx tsc \
  && cd ../dashboard && npx vite build

# Production dependencies for the server only.
FROM node:20-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
COPY packages/dashboard/package.json packages/dashboard/
COPY packages/sdk/package.json packages/sdk/
COPY packages/cli/package.json packages/cli/
RUN npm ci --omit=dev --workspace=packages/server && mkdir -p packages/server/node_modules

FROM node:20-bookworm-slim
WORKDIR /app
ARG COSTKEY_VERSION=dev
ARG COSTKEY_COMMIT=
ENV NODE_ENV=production PORT=4100 COSTKEY_VERSION=$COSTKEY_VERSION COSTKEY_COMMIT=$COSTKEY_COMMIT
COPY --from=deps /app/node_modules node_modules
# npm keeps some server dependencies beside the package rather than at the root.
COPY --from=deps /app/packages/server/node_modules packages/server/node_modules
COPY --from=deps /app/package.json ./
COPY --from=build /app/packages/shared/package.json packages/shared/
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/packages/server/package.json packages/server/
COPY --from=build /app/packages/server/dist packages/server/dist
# Price catalog snapshot: a fresh install has prices before its first sync.
COPY --from=build /app/packages/server/data packages/server/data
COPY --from=build /app/packages/dashboard/dist packages/dashboard/dist
USER node
EXPOSE 4100
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 4100) + '/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "packages/server/dist/index.js"]
