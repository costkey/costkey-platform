{
  "name": "costkey",
  "version": "0.6.1",
  "description": "Sentry for AI costs. Observe supported AI calls with async cost, token, latency, and usage telemetry; no gateway required.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "costkey": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "dist/**/*.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:overhead": "npm run build && node benchmarks/sdk-overhead.mjs",
    "test:pack": "npm run build && node benchmarks/check-pack.mjs",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "keywords": [
    "ai",
    "llm",
    "cost",
    "tracking",
    "observability",
    "openai",
    "anthropic",
    "gemini",
    "google",
    "azure",
    "tokens",
    "monitoring",
    "sentry",
    "tracing"
  ],
  "author": "CostKey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/costkey/costkey"
  },
  "homepage": "https://costkey.dev",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
